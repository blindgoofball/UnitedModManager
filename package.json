{
  "name": "united-mod-manager",
  "version": "0.0.1",
  "description": "Search, browse and install accessibility mods for mainstream games.",
  "main": "dist/main.js",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js && node scripts/build-catalog.js",
    "catalog": "node scripts/build-catalog.js",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^45.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}
